# Backend address (also enables the same-origin /backend watchlist proxy). Read when the dev server starts or at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Optional: public address of the site, used for social-preview metadata.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Do not put secrets in NEXT_PUBLIC_ variables: they are sent to every visitor's browser.
